# Mnemonic of the owner account (testnet only, never commit a real value).
OWNER_MNEMONIC=
# Agent Ed25519 secret key, 32-byte hex. A key can be linked to ONE account only; in demo.sh the per-run key
# comes from run.env (fresh-owner generates one per run), so this one serves the long-lived owner.
AGENT_ED25519_SK=
# Deployed GuardianVault address on diana.
VAULT_ADDRESS=
# Faucet test tokens deployed by contracts/script/DeployTokens.s.sol on diana.
FUSD_ADDRESS=
FETH_ADDRESS=
FBTC_ADDRESS=
# Optional: mnemonic of the account that submits `withdraw` (pays gas). Defaults to the owner.
RELAYER_MNEMONIC=

# --- Guardian agent (apps/agent). It never reads OWNER_MNEMONIC. ---
# Owner's EVM address (0x...) to watch and rescue for.
OWNER_EVM_ADDRESS=
# The agent's own funded account (the vault's guardian). It sends the rescue txs from its own
# EVM window and pays their gas.
GAS_MNEMONIC=
# The agent's EVM address (0x...), i.e. the GAS_MNEMONIC account. Deploy.s.sol makes it the vault's
# immutable guardian; the agent refuses to start if it differs from GAS_MNEMONIC's address.
GUARDIAN_ADDRESS=
# Comma-separated 0x addresses the owner may send to without triggering a rescue. Optional.
# ALLOWLIST and MAX_OUTBOUND only SEED the owner's policy file data/policy-<owner address>.json when it is
# missing; after that the file is the source of truth (edit it by hand or with PUT /policy, no restart needed).
ALLOWLIST=
# Largest outbound amount in wei that does not trigger a rescue. Optional, default 1000e18.
MAX_OUTBOUND=
# HTTP port of the agent API (GET /incidents, /events, /health; GET/PUT /policy), on 127.0.0.1 only.
# Optional, default 8787.
AGENT_PORT=
# Browser origins (comma-separated scheme://host[:port]) allowed to read and write /policy. Optional,
# default http://localhost:5173,http://127.0.0.1:5173 (the Vite dashboard).
DASHBOARD_ORIGINS=
# Optional Telegram alerts after each rescue / alert / low gas: set BOTH or neither. Keep the token secret.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Optional: POST every alert event as JSON to this http(s) URL.
ALERT_WEBHOOK_URL=
# Alert when the guardian (GAS_MNEMONIC) balance drops below this many wei. Optional, default 0.5 QOR.
GAS_LOW_WEI=
# Watcher poll interval in ms. Optional, default 300 (diana makes a block every ~1.4 s).
POLL_MS=
# Optional. Without it incident summaries use a deterministic template.
ANTHROPIC_API_KEY=

# --- Demo (./demo.sh, Task 5) ---
# Account that funds each fresh demo owner and relays attack step (b). Optional for ./demo.sh, defaults to
# OWNER_MNEMONIC; REQUIRED for ./demo.sh --drill and `pnpm cli drill-guardian init|check`, which never fall back to
# OWNER_MNEMONIC and refuse a funder that is the watched owner (OWNER_EVM_ADDRESS / OWNER_MNEMONIC).
# Must not be the GAS_MNEMONIC account. Spends FRESH_FUND_UQOR plus ~0.25 QOR in fees per run and must hold
# FRESH_FUND_UQOR + 0.5 QOR before each run.
FUNDER_MNEMONIC=
# uqor sent to each fresh owner. Optional, default 1500000 (1.5 QOR).
FRESH_FUND_UQOR=
# Do not set ATTACKER_ADDR, SAFE_ADDR or RUN_ID here: `pnpm cli fresh-owner` writes them, with the fresh
# owner's OWNER_MNEMONIC / OWNER_EVM_ADDRESS / VAULT_ADDRESS, to ~/.config/qday/runs/<run id>/run.env
# (outside the repo, mode 0600), and demo.sh loads that file on top of this one.

# --- Fire drill (Task 6G) ---
# `pnpm cli drill-guardian init` creates the drill's own guardian account in ~/.config/qday/drill-guardian.env
# (DRILL_GAS_MNEMONIC, DRILL_GUARDIAN_ADDRESS; outside the repo, mode 0600), funded to 2 QOR by FUNDER_MNEMONIC.
# It must differ from the GAS_MNEMONIC, OWNER_MNEMONIC and FUNDER_MNEMONIC accounts. Never put it in this file.
# HTTP port of the drill's own agent. Optional, default 8788; must differ from AGENT_PORT.
DRILL_AGENT_PORT=
