# Mnemonic of the owner account (testnet only, never commit a real value).
OWNER_MNEMONIC=
# Agent Ed25519 secret key, 32-byte hex.
AGENT_ED25519_SK=
# Deployed GuardianVault address on diana.
VAULT_ADDRESS=
# Faucet test tokens deployed by contracts/script/DeployTokens.s.sol on diana.
FUSD_ADDRESS=
FETH_ADDRESS=
FBTC_ADDRESS=
# Optional: mnemonic of the account that submits `withdraw` (pays gas). Defaults to the owner.
RELAYER_MNEMONIC=

# --- Guardian agent (apps/agent). It never reads OWNER_MNEMONIC. ---
# Owner's EVM address (0x...) to watch and rescue for.
OWNER_EVM_ADDRESS=
# The agent's own funded account (the vault's guardian). It sends the rescue txs from its own
# EVM window and pays their gas.
GAS_MNEMONIC=
# The agent's EVM address (0x...), i.e. the GAS_MNEMONIC account. Deploy.s.sol makes it the vault's
# immutable guardian; the agent refuses to start if it differs from GAS_MNEMONIC's address.
GUARDIAN_ADDRESS=
# Comma-separated 0x addresses the owner may send to without triggering a rescue. Optional.
ALLOWLIST=
# Largest outbound amount in wei that does not trigger a rescue. Optional, default 1000e18.
MAX_OUTBOUND=
# HTTP port of the incident API (GET /incidents, GET /events). Optional, default 8787.
AGENT_PORT=
# Optional. Without it incident summaries use a deterministic template.
ANTHROPIC_API_KEY=
